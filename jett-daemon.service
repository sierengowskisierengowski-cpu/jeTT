[Unit]
Description=jeTT AI EDR Daemon
Documentation=https://github.com/sierengowskisierengowski-cpu/jeTT
After=network.target

[Service]
Type=simple
EnvironmentFile=-/etc/default/jett
Environment=JETT_ALLOWLIST=/etc/jett/allowlist.conf
Environment=JETT_MODEL_PIN=/etc/jett/model.sha256
Environment=JETT_MODEL=/opt/jett/models/jeTT-q4.gguf

ExecStart=/usr/local/bin/jett-daemon
ExecStartPre=/usr/bin/test -x /usr/local/bin/jett-daemon

Restart=on-failure
RestartSec=5

# ── Systemd hardening ────────────────────────────────────────────────────────
# Prevent the daemon from acquiring new privileges after startup.
NoNewPrivileges=yes

# Give the daemon its own private /tmp that is invisible to other units.
PrivateTmp=yes

# Mount the whole filesystem read-only; grant write access only where needed.
ProtectSystem=strict
ReadWritePaths=/var/jett/quarantine /var/log/jett

# Allow read-only access to home directories (model may live under /opt).
ProtectHome=read-only

# Limit capabilities to process termination and `/proc` inspection.
CapabilityBoundingSet=CAP_KILL CAP_DAC_READ_SEARCH CAP_SYS_PTRACE
AmbientCapabilities=

# Prevent setuid/setgid bit abuse.
RestrictSUIDSGID=yes

# Lock the process personality to the native ABI.
LockPersonality=yes

# Keep the runtime deterministic and reduce kernel attack surface.
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallArchitectures=native
UMask=0077

# Prevent mapping memory both writable and executable (thwarts JIT shellcode).
MemoryDenyWriteExecute=yes

# Restrict address families to the minimum needed.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

# Allow only a safe subset of system calls.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
